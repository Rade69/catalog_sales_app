/* ==========================================================================
   KATALOŠKA PRODAJA - GLOBAL DESIGN SYSTEM
   ========================================================================== */

/* --------------------------------------------------------------------------
   COLOR PALETTE - DOCUMENTATION ONLY (Qt QSS doesn't support CSS variables)
   
   Mjenjaj boje ovdje kao referencu, zatim ažuriraj selektore ispod:
   
   Primary (Blue):
   --primary-50:  #eff6ff    --primary-600: #2563eb
   --primary-100: #dbeafe    --primary-700: #1d4ed8
   --primary-200: #bfdbfe    --primary-800: #1e40af
   --primary-300: #93c5fd    --primary-900: #1e3a8a
   --primary-400: #60a5fa
   --primary-500: #3b82f6
   
   Success (Green):
   --success-50:  #f0fdf4    --success-600: #16a34a
   --success-100: #dcfce7    --success-700: #15803d
   --success-200: #bbf7d0
   --success-300: #86efac
   --success-400: #4ade80
   --success-500: #22c55e
   
   Warning (Amber/Orange):
   --warning-50:  #fffbeb    --warning-600: #d97706
   --warning-100: #fef3c7    --warning-700: #b45309
   --warning-200: #fde68a
   --warning-300: #fcd34d
   --warning-400: #fbbf24
   --warning-500: #f59e0b
   
   Danger (Red):
   --danger-50:  #fef2f2    --danger-600: #dc2626
   --danger-100: #fee2e2    --danger-700: #b91c1c
   --danger-200: #fecaca
   --danger-300: #fca5a5
   --danger-400: #f87171
   --danger-500: #ef4444
   
   Neutral Grays:
   --gray-50:  #f9fafb    --gray-600: #4b5563
   --gray-100: #f3f4f6    --gray-700: #374151
   --gray-200: #e5e7eb    --gray-800: #1f2937
   --gray-300: #d1d5db    --gray-900: #111827
   --gray-400: #9ca3af
   --gray-500: #6b7280
   
   Text Colors:
   --primary-text:    #1f2937 (gray-800)
   --secondary-text:  #6b7280 (gray-500)
   --muted-text:      #9ca3af (gray-400)
   -------------------------------------------------------------------------- */


/* --------------------------------------------------------------------------
   GLOBAL STYLES
   -------------------------------------------------------------------------- */

QWidget {
    background-color: #f9fafb;
    color: #1f2937;
    font-family: "Segoe UI", "Liberation Sans", "DejaVu Sans", Arial, "Noto Color Emoji", "Noto Emoji", sans-serif;
    font-size: 15px;
}

/* QLabel mora biti transparentan da ne bi prekrivao pozadinu roditelja */
QLabel {
    background-color: transparent;
}

QMainWindow {
    background-color: #f9fafb;
}


/* --------------------------------------------------------------------------
   SIDEBAR
   -------------------------------------------------------------------------- */

#Sidebar {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #1e3c72,
        stop: 1 #2a5298
    );
    border-right: 1px solid #1a3a6a;
}

#SidebarTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding: 16px 12px;
    margin-bottom: 8px;
}

/* Navigation Buttons */
QPushButton[nav="true"] {
    background-color: transparent;
    color: #c5d5f0;
    border: none;
    text-align: left;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    margin: 4px 10px;
    min-height: 50px;
}

QPushButton[nav="true"]:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

QPushButton[nav="true"]:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Backup Button at Bottom */
QPushButton[backup="true"] {
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
    margin: 8px 10px;
    min-height: 42px;
}

QPushButton[backup="true"]:hover {
    background-color: rgba(255, 255, 255, 0.25);
}

QPushButton[backup="true"]:pressed {
    background-color: rgba(255, 255, 255, 0.3);
}


/* --------------------------------------------------------------------------
   TOP BAR / PAGE HEADER
   -------------------------------------------------------------------------- */

#TopBar {
    background-color: #1f4f9f;
    border: none;
    border-radius: 0;
    padding: 18px 24px;
    min-height: 70px;
}

#PageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
}

#PageSubtitle {
    color: #c5d5f0;
    font-size: 15px;
    margin-top: 4px;
}

#DashboardTopBar {
    background-color: #1f4f9f;
    border: none;
    padding: 16px 24px;
    min-height: 70px;
}

#DashboardTitle {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
}

#DashboardSubtitle {
    color: #c5d5f0;
    font-size: 13px;
    margin-top: 2px;
}


/* --------------------------------------------------------------------------
   CARDS
   -------------------------------------------------------------------------- */

QFrame[card="true"],
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}

QGroupBox {
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    color: #374151;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #1f2937;
    font-weight: 700;
}


/* --------------------------------------------------------------------------
   BUTTONS
   -------------------------------------------------------------------------- */

/* Primary Button (Blue) */
QPushButton[primary="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 15px;
    min-height: 44px;
}

QPushButton[primary="true"]:hover {
    background-color: #1d4ed8;
}

QPushButton[primary="true"]:pressed {
    background-color: #1e40af;
}

QPushButton[primary="true"]:disabled {
    background-color: #9ca3af;
    color: #d1d5db;
}

/* Secondary Button (White with border) */
QPushButton[secondary="true"] {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 15px;
    min-height: 44px;
}

QPushButton[secondary="true"]:hover {
    background-color: #f3f4f6;
    border-color: #9ca3af;
}

QPushButton[secondary="true"]:pressed {
    background-color: #e5e7eb;
}

/* Danger Button (Red) */
QPushButton[danger="true"] {
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 15px;
    min-height: 44px;
}

QPushButton[danger="true"]:hover {
    background-color: #b91c1c;
}

QPushButton[danger="true"]:pressed {
    background-color: #991b1b;
}

/* Success Button (Green) */
QPushButton[success="true"] {
    background-color: #16a34a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
    min-height: 40px;
}

QPushButton[success="true"]:hover {
    background-color: #15803d;
}

QPushButton[success="true"]:pressed {
    background-color: #14532d;
}

/* Warning Button (Orange) */
QPushButton[warning="true"] {
    background-color: #d97706;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
    min-height: 40px;
}

QPushButton[warning="true"]:hover {
    background-color: #b45309;
}

QPushButton[warning="true"]:pressed {
    background-color: #92400e;
}

/* Default Button */
QPushButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 15px;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #e5e7eb;
}

QPushButton:pressed {
    background-color: #d1d5db;
}

/* Import Button */
QPushButton[importBtn="true"] {
    background-color: #059669;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 700;
    font-size: 13px;
    min-height: 40px;
}

QPushButton[importBtn="true"]:hover {
    background-color: #047857;
}

QPushButton[importBtn="true"]:pressed {
    background-color: #065f46;
}

QPushButton[importBtn="true"]:disabled {
    background-color: #d1d5db;
    color: #9ca3af;
}

/* Delete Button */
QPushButton[deleteBtn="true"] {
    background-color: #dc2626;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
    min-height: 36px;
}

QPushButton[deleteBtn="true"]:hover {
    background-color: #b91c1c;
}

QPushButton[deleteBtn="true"]:disabled {
    background-color: #d1d5db;
    color: #9ca3af;
}

/* Excel File Label */
QLabel[excelFile="true"] {
    color: #9ca3af;
    font-style: italic;
}

QLabel[excelFile="true"][excelFileSelected="true"] {
    color: #059669;
    font-weight: bold;
}

/* Orders Page Tabs */
QTabWidget[ordersTabs="true"]::pane {
    border: none;
    background: transparent;
}

QTabWidget[ordersTabs="true"]::pane > QTabBar::tab {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    padding: 10px 28px;
    font-size: 13px;
    font-weight: 600;
    margin-right: 2px;
    border-radius: 6px 6px 0 0;
}

QTabWidget[ordersTabs="true"]::pane > QTabBar::tab:selected {
    background: #ffffff;
    color: #111827;
    border-bottom: 2px solid #059669;
}

QTabWidget[ordersTabs="true"]::pane > QTabBar::tab:hover:!selected {
    background: #e2e8f0;
    color: #374151;
}

/* Source Frame */
QFrame[sourceFrame="true"] {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}

/* Form Label */
QLabel[formLabel="true"] {
    font-weight: 600;
    color: #374151;
    border: none;
}

/* Inline Radio Button */
QRadioButton[inlineRadio="true"] {
    border: none;
}

/* Save Button */
QPushButton[saveBtn="true"] {
    background: #059669;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    min-height: 44px;
}

QPushButton[saveBtn="true"]:hover {
    background: #047857;
}

QPushButton[saveBtn="true"]:pressed {
    background: #065f46;
}

/* Articles Table */
QTableWidget[articlesTable="true"] {
    font-size: 13px;
}

QTableWidget[articlesTable="true"]::item {
    padding: 6px 8px;
}

QTableWidget[articlesTable="true"]::item:selected {
    background: #dbeafe;
    color: #1d4ed8;
}

/* Delete Orders Button */
QPushButton[deleteOrdersBtn="true"] {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fca5a5;
    border-radius: 8px;
    font-weight: 700;
    padding: 0 16px;
    min-height: 36px;
}

QPushButton[deleteOrdersBtn="true"]:hover {
    background: #fecaca;
}

QPushButton[deleteOrdersBtn="true"]:disabled {
    background: #f9fafb;
    color: #d1d5db;
    border-color: #e5e7eb;
}

/* Orders Table */
QTableWidget[ordersTable="true"] {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    gridline-color: #eef2f7;
    font-size: 16px;
}

QTableWidget[ordersTable="true"]::item {
    padding: 8px;
    color: #1f2937;
    background-color: transparent;
}

QTableWidget[ordersTable="true"]::item:alternate {
    background-color: #f9fafb;
}

QTableWidget[ordersTable="true"]::item:hover {
    background-color: #f3f4f6;
}

QTableWidget[ordersTable="true"]::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}

/* Dialog Styles */
QLabel[dialogTitle="true"] {
    font-weight: 800;
    color: #111827;
}

QFrame[infoFrame="true"] {
    background: #f9fafb;
    border-radius: 10px;
    padding: 16px;
}

QLabel[infoText="true"] {
    color: #1f2937;
}

QLabel[dialogSectionTitle="true"] {
    font-weight: 700;
    color: #111827;
    margin-top: 10px;
}

QTableWidget[dialogTable="true"] {
    font-size: 18px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QTableWidget[dialogTable="true"]::item {
    padding: 10px;
}

QTableWidget[dialogTable="true"]::indicator {
    background: #e5e7eb;
}

QPushButton[dialogCloseBtn="true"] {
    background: #2563eb;
    color: white;
    font-size: 18px;
    font-weight: 700;
    padding: 14px 40px;
    border-radius: 10px;
    min-height: 50px;
}

QPushButton[dialogCloseBtn="true"]:hover {
    background: #1d4ed8;
}


/* --------------------------------------------------------------------------
   TABLES
   -------------------------------------------------------------------------- */

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    gridline-color: #f3f4f6;
    font-size: 16px;
    selection-background-color: #dbeafe;
    selection-color: #1e40af;
}

QTableWidget::item {
    padding: 12px 14px;
    border-bottom: 1px solid #f3f4f6;
}

QTableWidget::item:hover {
    background-color: #f9fafb;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}

QHeaderView::section {
    background-color: #f3f4f6;
    color: #374151;
    font-weight: 700;
    font-size: 14px;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QTableWidget::corner {
    background-color: #f3f4f6;
    border: none;
}


/* --------------------------------------------------------------------------
   INPUTS - QLineEdit, QTextEdit, QComboBox, QSpinBox, QDateEdit
   -------------------------------------------------------------------------- */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 15px;
    color: #1f2937;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #2563eb;
    outline: none;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #9ca3af;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 15px;
    color: #1f2937;
    min-height: 44px;
}

QComboBox:focus {
    border-color: #2563eb;
    outline: none;
}

QComboBox:hover {
    border-color: #9ca3af;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6b7280;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 40px;
    padding: 8px 12px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f3f4f6;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

/* SpinBox */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1f2937;
    min-height: 40px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #2563eb;
    outline: none;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #9ca3af;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

/* DateEdit */
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1f2937;
    min-height: 40px;
}

QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: #2563eb;
    outline: none;
}

QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover {
    border-color: #9ca3af;
}

QDateEdit::drop-down,
QTimeEdit::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    width: 30px;
}


/* --------------------------------------------------------------------------
   STATUS BADGES
   -------------------------------------------------------------------------- */

/* Success Badge (Green) */
QLabel[status="success"],
QLabel[badge="success"] {
    background-color: #dcfce7;
    color: #166534;
    font-weight: 700;
    font-size: 11px;
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 70px;
}

/* Warning Badge (Orange) */
QLabel[status="warning"],
QLabel[badge="warning"] {
    background-color: #fef3c7;
    color: #92400e;
    font-weight: 700;
    font-size: 11px;
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 70px;
}

/* Danger Badge (Red) */
QLabel[status="danger"],
QLabel[badge="danger"] {
    background-color: #fee2e2;
    color: #991b1b;
    font-weight: 700;
    font-size: 11px;
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 70px;
}

/* Info Badge (Blue) */
QLabel[status="info"],
QLabel[badge="info"] {
    background-color: #dbeafe;
    color: #1e40af;
    font-weight: 700;
    font-size: 11px;
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 70px;
}

/* Neutral Badge (Gray) */
QLabel[status="neutral"],
QLabel[badge="neutral"] {
    background-color: #f3f4f6;
    color: #6b7280;
    font-weight: 700;
    font-size: 11px;
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 70px;
}


/* --------------------------------------------------------------------------
   KPI CARDS
   -------------------------------------------------------------------------- */

QLabel[kpiTitle="true"] {
    color: #6b7280;
    font-size: 13px;
    font-weight: 600;
}

QLabel[kpiValue="true"] {
    color: #111827;
    font-size: 36px;
    font-weight: 800;
}

QLabel[sectionTitle="true"] {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
}

/* Dashboard KPI Cards - Base */
QFrame[kpiCard="true"] {
    background-color: #ffffff;
    border-radius: 10px;
}

QFrame[kpiCard="true"][cardType="kupci"] {
    border-left: 4px solid #2563eb;
}

QFrame[kpiCard="true"][cardType="narudzbe"] {
    border-left: 4px solid #3b82f6;
}

QFrame[kpiCard="true"][cardType="dug"] {
    border-left: 4px solid #dc2626;
}

QFrame[kpiCard="true"][cardType="naplaceno"] {
    border-left: 4px solid #16a34a;
}

QFrame[kpiCard="true"]:hover {
    border: 1px solid #d1d5db;
}

/* KPI Card Decorative Bottom */
QFrame[kpiCardDecorative="true"] {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 0;
}

/* Dashboard Status Cards */
QFrame[statusCard="true"][statusType="overdue"] {
    background-color: #fef2f2;
    border-radius: 10px;
    border: 1px solid #fecaca;
}

QFrame[statusCard="true"][statusType="month"] {
    background-color: #fff7ed;
    border-radius: 10px;
    border: 1px solid #fed7aa;
}

QFrame[statusCard="true"] QLabel {
    color: #1f2937;
}

QFrame[statusCard="true"][statusType="overdue"] QLabel[statusTitle="true"] {
    color: #991b1b;
}

QFrame[statusCard="true"][statusType="overdue"] QLabel[statusValue="true"] {
    color: #dc2626;
}

QFrame[statusCard="true"][statusType="month"] QLabel[statusTitle="true"] {
    color: #9a3412;
}

QFrame[statusCard="true"][statusType="month"] QLabel[statusValue="true"] {
    color: #ea580c;
}

/* Dashboard Table Cards */
QFrame[dashboardTable="true"] {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
}

QFrame[dashboardTable="true"] QLabel[tableTitle="true"] {
    font-size: 15px;
    font-weight: 700;
    color: #1f2937;
}


/* --------------------------------------------------------------------------
   PROGRESS BAR
   -------------------------------------------------------------------------- */

QProgressBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 6px;
    text-align: center;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 6px;
}

QProgressBar[status="success"]::chunk {
    background-color: #16a34a;
}

QProgressBar[status="warning"]::chunk {
    background-color: #d97706;
}

QProgressBar[status="danger"]::chunk {
    background-color: #dc2626;
}


/* --------------------------------------------------------------------------
   SCROLL BARS
   -------------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: #f9fafb;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #d1d5db;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #f9fafb;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #d1d5db;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* --------------------------------------------------------------------------
   TAB WIDGET
   -------------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #f3f4f6;
    color: #6b7280;
    padding: 10px 20px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}

QTabBar::tab:hover:!selected {
    background-color: #e5e7eb;
}


/* --------------------------------------------------------------------------
   CHECKBOX & RADIO
   -------------------------------------------------------------------------- */

QCheckBox,
QRadioButton {
    color: #1f2937;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #d1d5db;
    background-color: #ffffff;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #2563eb;
}

QRadioButton::indicator {
    border-radius: 9px;
}


/* --------------------------------------------------------------------------
   LABELS - Utility Classes
   -------------------------------------------------------------------------- */

QLabel[error="true"] {
    color: #dc2626;
    font-size: 13px;
}

QLabel[success="true"] {
    color: #16a34a;
    font-size: 13px;
}

QLabel[warning="true"] {
    color: #d97706;
    font-size: 13px;
}

QLabel[help="true"] {
    color: #6b7280;
    font-size: 12px;
    font-style: italic;
}

/* Loading Label */
QLabel[loading="true"] {
    color: #6b7280;
    font-size: 14px;
    font-style: italic;
    padding: 8px;
}

/* Placeholder Label */
QLabel[placeholder="true"] {
    color: #9ca3af;
    font-size: 14px;
}

/* Count Label */
QLabel[countLabel="true"] {
    color: #9ca3af;
    font-size: 11px;
}

/* Section Title */
QLabel[sectionTitle="true"] {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
}

/* Hint Label */
QLabel[hint="true"] {
    color: #6b7280;
    font-size: 12px;
    font-style: italic;
}

/* Filter Label */
QLabel[filterLabel="true"] {
    color: #6b7280;
    font-size: 12px;
}

/* Status Banner - Success */
QLabel[statusBanner="success"] {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

/* Status Banner - Error */
QLabel[statusBanner="error"] {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

/* Status Banner - Warning */
QLabel[statusBanner="warning"] {
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fcd34d;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}


/* --------------------------------------------------------------------------
   SPLITTER
   -------------------------------------------------------------------------- */

QSplitter::handle {
    background-color: #e5e7eb;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #2563eb;
}

/* Splitter Handle - Inline Helper Class */
QSplitter[cardSplitter="true"]::handle {
    background: #e5e7eb;
}


/* --------------------------------------------------------------------------
   FILTER BUTTONS
   -------------------------------------------------------------------------- */

/* Filter Button Base */
QPushButton[filterBtn="true"] {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 0px 10px;
    background: white;
    color: #374151;
    font-weight: 600;
    font-size: 12px;
    min-height: 34px;
}

/* Filter Button Checked */
QPushButton[filterBtn="true"]:checked {
    background: #2563eb;
    color: white;
    border-color: #2563eb;
}

/* Filter Button Hover */
QPushButton[filterBtn="true"]:hover:!checked {
    background: #f3f4f6;
}

/* Preview Frame */
QFrame[preview="true"] {
    background: #f0fdf4;
    border: 2px solid #059669;
    border-radius: 10px;
    margin-top: 4px;
}

/* Preview Title */
QLabel[previewTitle="true"] {
    color: #059669;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
}

/* Preview Total */
QLabel[previewTotal="true"] {
    font-size: 18px;
    font-weight: 800;
    color: #111827;
}

/* Preview Installment */
QLabel[previewInstallment="true"] {
    font-size: 13px;
    color: #374151;
}


/* --------------------------------------------------------------------------
   LIST WIDGET
   -------------------------------------------------------------------------- */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    outline: none;
    font-size: 16px;
}

QListWidget::item {
    padding: 12px 14px;
    border-bottom: 1px solid #f3f4f6;
}

QListWidget::item:hover {
    background-color: #f9fafb;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}


/* --------------------------------------------------------------------------
   GROUP BOX
   -------------------------------------------------------------------------- */

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 700;
    color: #1f2937;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #1f2937;
}

/* Custom Group Boxes */
QGroupBox[formGroup="true"],
QGroupBox[ordersGroup="true"] {
    font-weight: bold;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 12px;
}

QGroupBox[formGroup="true"]::title,
QGroupBox[ordersGroup="true"]::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}


/* --------------------------------------------------------------------------
   TOOL TIP
   -------------------------------------------------------------------------- */

QToolTip {
    background-color: #1f2937;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}


/* --------------------------------------------------------------------------
   STATUS BAR
   -------------------------------------------------------------------------- */

QStatusBar {
    background-color: #111827;
    color: #9ca3af;
    font-size: 11px;
    border-top: 1px solid #1f2937;
}

QStatusBar::item {
    border: none;
}


/* --------------------------------------------------------------------------
   MENU BAR
   -------------------------------------------------------------------------- */

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 4px 0;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #f3f4f6;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 8px;
}
